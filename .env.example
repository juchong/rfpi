# =============================================================================
# .env.example - placeholder template (safe to commit, NOT encrypted)
# Copy real values into .env (which IS encrypted via git-crypt).
# This template documents only the variables; see .env for the full set.
# =============================================================================

# -----------------------------------------------------------------------------
# BME680 -> MQTT publisher
# -----------------------------------------------------------------------------
# Broker connection (use your existing broker)
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme

# Publisher behaviour (optional - sensible defaults applied if unset)
BME680_TOPIC_PREFIX=rfpi/bme680
BME680_INTERVAL=30
BME680_I2C_ADDR=0x77
BME680_HA_DISCOVERY=true
